auto-update = download

macos-titlebar-style = tabs
# macos-titlebar-style = transparent
gtk-tabs-location = bottom

# cmd+d / cmd+shift+d splits, cmd+t tabs, and new windows should start
# in the current terminal directory when shell integration reports it.
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

shell-integration = zsh
shell-integration-features = no-title

# Note: system bell is broken on macOS Ghostty (known issue)
# Using title (🔔 prefix) and attention (dock bounce) instead
bell-features = title,attention

mouse-scroll-multiplier = 1

mouse-hide-while-typing = true
confirm-close-surface = false

clipboard-read = "allow"
clipboard-paste-protection = false

font-thicken = true
font-family = "Liga SFMono Nerd Font"
font-size = 12
font-feature = zero
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = calt
font-feature = liga

keybind = cmd+zero=reset_font_size
keybind = super+t=new_tab
# keybind = cmd+c=copy_to_clipboard
# keybind = cmd+v=paste_from_clipboard
# keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = ctrl+shift+p=toggle_command_palette


cursor-color = f8db4a

font-codepoint-map = U+e0b0-U+e0b3,U+e0b4-U+e0c8,U+e0cc-U+e0d4,U+e0ca=JetBrainsMono Nerd Font Mono

theme = dark:Catppuccin Mocha,light:Catppuccin Frappe

