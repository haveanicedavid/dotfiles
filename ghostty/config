auto-update = download

macos-titlebar-style = tabs
# macos-titlebar-style = transparent
gtk-tabs-location = bottom

shell-integration = detect
shell-integration-features = no-title

bell-features = title,attention

mouse-scroll-multiplier = 1

mouse-hide-while-typing = true
confirm-close-surface = false

clipboard-read = "allow"
clipboard-paste-protection = false

font-thicken = true
font-family = "Liga SFMono Nerd Font"
font-size = 12
font-feature = zero
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = calt
font-feature = liga

keybind = cmd+zero=reset_font_size
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
# keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = ctrl+shift+p=toggle_command_palette


cursor-color = f8db4a

font-codepoint-map = U+e0b0-U+e0b3,U+e0b4-U+e0c8,U+e0cc-U+e0d4,U+e0ca=JetBrainsMono Nerd Font Mono

theme = dark:Catppuccin Mocha,light:Catppuccin Frappe

# theme = Catppuccin Macchiato
# theme = Catppuccin Mocha
