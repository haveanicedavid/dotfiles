{
  // Vim mode (you have this enabled)
  "vim_mode": true,

  // Font settings (matching your VS Code config)
  "buffer_font_family": "Ligalex Mono, Liga SFMono Nerd Font, SF Mono, MonoLisa, FiraCode",
  "buffer_font_size": 13,
  "buffer_font_weight": 500,
  "buffer_line_height": {
    "custom": 1.174
  },
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },

  // UI font
  "ui_font_size": 14,
  "ui_font_family": "SF Pro Display",

  // Theme (Catppuccin like your VS Code)
  "theme": {
    "mode": "system",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Macchiato"
  },

  // Editor behavior
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,

  // Auto-save on focus change (matching files.autoSave: onFocusChange)
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },

  // Disable minimap (matching editor.minimap.enabled: false)
  "minimap": {
    "show": "never"
  },

  // Scrollbar settings
  "scrollbar": {
    "show": "auto"
  },

  // Sticky scroll (matching editor.stickyScroll.enabled: true)
  "sticky_scroll": {
    "enabled": true
  },

  // Bracket pair colorization
  "bracket_pair_colorization": {
    "enabled": true
  },

  // Indent guides (matching editor.guides.bracketPairs: true)
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },

  // Tab bar (matching window.density.editorTabHeight: compact)
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true
  },

  // Toolbar
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true
  },

  // File exclusions (matching your files.exclude)
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/node_modules",
    "**/.next",
    "**/dist",
    "**/coverage",
    "**/.DS_Store",
    "**/*.js.map"
  ],

  // Git settings
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    }
  },

  // Terminal (matching your terminal settings)
  "terminal": {
    "shell": {
      "program": "zsh"
    },
    "font_family": "Roboto Mono Light for Powerline",
    "font_size": 13,
    "line_height": {
      "custom": 1.2
    },
    "blinking": "on",
    "copy_on_select": false
  },

  // Completions
  "show_completions_on_input": true,
  "show_completion_documentation": true,

  // Inlay hints
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true
  },

  // Project panel (sidebar)
  "project_panel": {
    "button": true,
    "dock": "left",
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": false,
    "scrollbar": {
      "show": "auto"
    }
  },

  // Outline panel
  "outline_panel": {
    "dock": "left"
  },

  // Collaboration panel
  "collaboration_panel": {
    "dock": "left"
  },

  // Chat panel
  "chat_panel": {
    "dock": "right"
  },

  // Assistant panel (AI)
  "agent": {
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514"
    }
  },

  // Prettier formatting (matching your prettier settings)
  "prettier": {
    "allowed": true
  },

  // Language-specific settings
  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "TSX": {
      "tab_size": 2,
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "JSON": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "YAML": {
      "tab_size": 2,
      "format_on_save": "off"
    },
    "Markdown": {
      "soft_wrap": "editor_width",
      "format_on_save": "off"
    },
    "CSS": {
      "tab_size": 2
    },
    "TOML": {
      "tab_size": 2,
      "format_on_save": "on"
    },
  },

  // Telemetry
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },

  // Restore last session
  "restore_on_startup": "last_session",

  // Show whitespace (matching editor.renderWhitespace: trailing)
  "show_whitespaces": "selection",

  // Preview tabs (matching workbench.editor.enablePreviewFromQuickOpen)
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true
  },

  // Confirm quit
  "confirm_quit": true,

  // Current line highlight
  "current_line_highlight": "gutter",

  // Cursor blink
  "cursor_blink": true,

  // Hover popover delay
  "hover_popover_enabled": true,

  // Gutter
  "gutter": {
    "line_numbers": true,
    "code_actions": true,
    "runnables": true,
    "folds": true
  },

  // Search
  "search": {
    "whole_word": false,
    "case_sensitive": false,
    "include_ignored": false,
    "regex": false
  },

  // File associations (matching your files.associations)
  "file_types": {
    "TOML": ["*.toml", "aerospace.toml", "stylua.toml"],
    "Clojure": ["*.edn"],
    "Fish": ["config.fish"],
    "Plain Text": ["**/ghostty/config", "*.ghostty"]
  }
}
